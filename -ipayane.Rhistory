lines(c(0,1),c(0,1),typ="l",lty=1,col="black")
text(0.8,0.6,"Fleet 1",col=2)
text(0.8,0.5,"Fleet 2",col=3)
text(0.8,0.4,"Fleet 3",col=4)
text(0.8,0.3,"Fleet 4",col=5)
Totales=cbind(NT,BT,SBT,YT,YT1,YT2,YT3,YT4,CPUE1,CPUE2,CPUE3,CPUE4,Bacus1,Bacus2,MPH)
colnames(Totales)<-c("NT","BT","SBT","YT","YT1","YT2","YT3","YT4","CPUE1","CPUE2","CPUE3","CPUE4","Bacus1","Bacus2","MPH")
Totales<-as.data.frame(Totales)
par(mar=c(4,4,1,1))
par(mfcol=c(4,1))
plot(tbins,Totales$CPUE1,typ="l",ylim=c(0,max(Totales$CPUE1)),xlab="Year_Month",ylab="CPUE 1",col=2)
plot(tbins,Totales$CPUE2,typ="l",ylim=c(0,max(Totales$CPUE2)),xlab="Year_Month",ylab="CPUE 2",col=3)
plot(tbins,Totales$CPUE3,typ="l",ylim=c(0,max(Totales$CPUE3)),xlab="Year_Month",ylab="CPUE 3",col=4)
plot(tbins,Totales$CPUE4,typ="l",ylim=c(0,max(Totales$CPUE4)),xlab="Year_Month",ylab="CPUE 4",col=5)
