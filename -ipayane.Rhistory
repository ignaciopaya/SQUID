plot(tbins[aniomes],Totales$CPUE4[aniomes],typ="l",ylim=c(min(Totales$CPUE4[aniomes]),max(Totales$CPUE4[aniomes])),xlab="Year_Month",ylab="CPUE 4",col=4)
