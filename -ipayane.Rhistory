plot(tbins[aniomes],Totales$CPUE2[aniomes],typ="l",ylim=c(min(Totales$CPUE2[aniomes]),max(Totales$CPUE2[aniomes])),xlab="Year_Month",ylab="CPUE 2",col=2)
